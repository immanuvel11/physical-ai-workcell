<?xml version="1.0"?>
<package format="3">
  <name>pai_safety</name>
  <version>0.1.0</version>
  <description>Safety supervisor (speed and separation monitoring, e-stop, sensor watchdog) and a simulated co-worker.</description>
  <maintainer email="m.immanuvel.11@gmail.com">Immanuvel M</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>pai_core</exec_depend>
  <exec_depend>pai_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
